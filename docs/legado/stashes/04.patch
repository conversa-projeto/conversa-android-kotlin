+package com.conversa.conversa.service
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+import com.conversa.conversa.ui.chamada.ChamadaActivity
+
+/**
+ * BroadcastReceiver para ações de chamada (Recusar, etc)
+ */
+class ChamadaBroadcastReceiver : BroadcastReceiver() {
+
+    companion object {
+        private const val TAG = "ChamadaBroadcastReceiver"
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        val action = intent.action
+        val chamadaId = intent.getIntExtra("chamada_id", -1)
+        val usuarioId = intent.getIntExtra("usuario_id", -1)
+
+        Log.d(TAG, "📞 BroadcastReceiver - Action: $action, chamadaId: $chamadaId")
+
+        when (action) {
+            "ACTION_RECUSAR_CHAMADA" -> {
+                Log.d(TAG, "❌ Recusando chamada: $chamadaId")
+                recusarChamada(context, chamadaId, usuarioId)
+            }
+        }
+    }
+
+    private fun recusarChamada(context: Context, chamadaId: Int, usuarioId: Int) {
+        // Para o ringtone
+        // (Vamos acessar o SocketService para parar o ringtone)
+        val stopRingtoneIntent = Intent(context, SocketService::class.java).apply {
+            action = "ACTION_STOP_RINGTONE"
+            putExtra("chamada_id", chamadaId)
+        }
+        context.startService(stopRingtoneIntent)
+
+        // Envia recusa via socket
+        ChamadaActivity.sharedSocketManager?.recusarChamada(chamadaId)
+
+        Log.d(TAG, "✅ Chamada $chamadaId recusada")
+    }
+}
