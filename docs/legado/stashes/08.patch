+    indices = [Index("mensagemId")]
+)
+data class ConteudoEntity(
+    @PrimaryKey(autoGenerate = true)
+    val id: Int = 0,
+    val mensagemId: Int,
+    val tipo: Int,  // 1=Texto, 2=Imagem, 3=Arquivo, 4=Audio
+    val ordem: Int,
+    val conteudo: String,
+    val nome: String?,
+    val extensao: String?
+)
