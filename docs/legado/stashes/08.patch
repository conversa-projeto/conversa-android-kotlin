+     │    Status: Pendente          │                             │
+     │<─────Response(chamada_id=1)──┤                             │
+     │ {                            │                             │
+     │   id: 1,                     │                             │
+     │   status: 1, // Pendente     │                             │
+     │   usuarios: [...]            │                             │
+     │ }                            │                             │
+     │                              │                             │
+     │                              │ 3. Notifica Maria           │
+     │                              ├─WS: ChamadaRecebida────────>│
+     │                              │ {                           │
+     │                              │   tipo: 51,                 │
+     │                              │   chamada_id: 1,            │
+     │                              │   usuario_id: 1 // João     │
+     │                              │ }                           │
+     │                              │                             │
+     │                              │                             │
