+package com.conversa.conversa.data.model
+
+/**
+ * Manager para downloads e cache de anexos
+ */
+data class AnexoDownload(
+    val identificador: String,
+    val tipo: Int, // 2=Imagem, 3=Arquivo, 4=Audio
+    val nome: String?,
+    val extensao: String?,
+    val tamanho: Long = 0,
+    val progresso: Int = 0, // 0-100
+    val status: DownloadStatus = DownloadStatus.PENDENTE,
+    val caminhoLocal: String? = null
+)
+
+enum class DownloadStatus {
+    PENDENTE,
+    BAIXANDO,
+    CONCLUIDO,
+    ERRO,
+    CANCELADO
+}
+
+/**
+ * Informações de um anexo na UI
+ */
+data class AnexoInfo(
+    val identificador: String,
+    val tipo: Int,
+    val nome: String,
+    val extensao: String?,
+    val tamanho: Long? = null,
+    val urlLocal: String? = null,
+    val thumbnail: String? = null
+)
