<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da janela; as telas usam o ConversaTema (Compose). Cores: docs/design/cores.md. -->
    <style name="Theme.Conversa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo_app</item>
    </style>

    <!-- Splash (androidx.core.splashscreen) -->
    <style name="Theme.Conversa.Inicial" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fundo_app</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Conversa</item>
    </style>
</resources>
